<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =================================================================
         BEE DPI master mark: a bee inside the yellow hexagon.

         The vector geometry below is the single application-side source of
         truth. assets/brand/bee-master.svg mirrors it for designers, and
         tools/Generate-BrandAssets.ps1 renders the same composition to the
         transparent PNG/ICO files. No bitmap is used for the in-window logo,
         so the mark stays sharp at every DPI scale.

         BeeLogoImage      = full detail, used at 48 px and above.
         BeeMarkImage      = simplified for 12-32 px (no antennae/stinger),
                             so the bee remains readable in the title bar and
                             in the 16/24/32 px Windows icon frames.
         ================================================================= -->

    <LinearGradientBrush x:Key="BeeHexFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD951" Offset="0" />
        <GradientStop Color="#FFC928" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BeeWingBrush" Color="#EFFFF4D3" />
    <SolidColorBrush x:Key="BeeBodyBrush" Color="#14151A" />
    <SolidColorBrush x:Key="BeeStripeBrush" Color="#FFC928" />
    <SolidColorBrush x:Key="BeeEyeBrush" Color="#FFD951" />
    <SolidColorBrush x:Key="BeeRimBrush" Color="#FFE07A" />

    <Geometry x:Key="BeeHexGeometry">M 128,6 L 231,65 L 231,191 L 128,250 L 25,191 L 25,65 Z</Geometry>

    <!-- Full-detail bee -->
    <GeometryGroup x:Key="BeeWingsGeometry">
        <EllipseGeometry Center="86,101" RadiusX="43" RadiusY="20">
            <EllipseGeometry.Transform>
                <RotateTransform Angle="-25" CenterX="86" CenterY="101" />
            </EllipseGeometry.Transform>
        </EllipseGeometry>
        <EllipseGeometry Center="170,101" RadiusX="43" RadiusY="20">
            <EllipseGeometry.Transform>
                <RotateTransform Angle="25" CenterX="170" CenterY="101" />
            </EllipseGeometry.Transform>
        </EllipseGeometry>
    </GeometryGroup>

    <EllipseGeometry x:Key="BeeBodyGeometry" Center="128,151" RadiusX="30" RadiusY="46" />
    <EllipseGeometry x:Key="BeeBodyClipGeometry" Center="128,151" RadiusX="30" RadiusY="46" />
    <EllipseGeometry x:Key="BeeHeadGeometry" Center="128,88" RadiusX="27" RadiusY="27" />

    <RectangleGeometry x:Key="BeeStripe1Geometry" Rect="86,126,84,12" />
    <RectangleGeometry x:Key="BeeStripe2Geometry" Rect="86,153,84,13" />
    <RectangleGeometry x:Key="BeeStripe3Geometry" Rect="86,180,84,12" />

    <Geometry x:Key="BeeAntennaLeftGeometry">M 114,73 C 101,58 91,48 76,40</Geometry>
    <Geometry x:Key="BeeAntennaRightGeometry">M 142,73 C 155,58 165,48 180,40</Geometry>
    <Geometry x:Key="BeeStingerGeometry">M 120,195 L 136,195 L 128,213 Z</Geometry>

    <GeometryGroup x:Key="BeeEyesGeometry">
        <EllipseGeometry Center="117,83" RadiusX="5.5" RadiusY="5.5" />
        <EllipseGeometry Center="139,83" RadiusX="5.5" RadiusY="5.5" />
    </GeometryGroup>

    <DrawingImage x:Key="BeeLogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BeeHexFillBrush}"
                                 Geometry="{StaticResource BeeHexGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource BeeRimBrush}" Thickness="4" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <GeometryDrawing Brush="{StaticResource BeeWingBrush}"
                                 Geometry="{StaticResource BeeWingsGeometry}" />

                <GeometryDrawing Brush="{StaticResource BeeBodyBrush}"
                                 Geometry="{StaticResource BeeBodyGeometry}" />
                <GeometryDrawing Brush="{StaticResource BeeBodyBrush}"
                                 Geometry="{StaticResource BeeHeadGeometry}" />

                <GeometryDrawing Geometry="{StaticResource BeeAntennaLeftGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource BeeBodyBrush}" Thickness="7"
                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="{StaticResource BeeAntennaRightGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource BeeBodyBrush}" Thickness="7"
                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <GeometryDrawing Brush="{StaticResource BeeBodyBrush}"
                                 Geometry="{StaticResource BeeStingerGeometry}" />

                <GeometryDrawing Brush="{StaticResource BeeStripeBrush}">
                    <GeometryDrawing.Geometry>
                        <CombinedGeometry GeometryCombineMode="Intersect"
                                          Geometry1="{StaticResource BeeStripe1Geometry}"
                                          Geometry2="{StaticResource BeeBodyClipGeometry}" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource BeeStripeBrush}">
                    <GeometryDrawing.Geometry>
                        <CombinedGeometry GeometryCombineMode="Intersect"
                                          Geometry1="{StaticResource BeeStripe2Geometry}"
                                          Geometry2="{StaticResource BeeBodyClipGeometry}" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource BeeStripeBrush}">
                    <GeometryDrawing.Geometry>
                        <CombinedGeometry GeometryCombineMode="Intersect"
                                          Geometry1="{StaticResource BeeStripe3Geometry}"
                                          Geometry2="{StaticResource BeeBodyClipGeometry}" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="{StaticResource BeeEyeBrush}"
                                 Geometry="{StaticResource BeeEyesGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Small-size variant: same silhouette, thicker bee, two stripes. -->
    <GeometryGroup x:Key="BeeMarkWingsGeometry">
        <EllipseGeometry Center="88,104" RadiusX="42" RadiusY="19">
            <EllipseGeometry.Transform>
                <RotateTransform Angle="-24" CenterX="88" CenterY="104" />
            </EllipseGeometry.Transform>
        </EllipseGeometry>
        <EllipseGeometry Center="168,104" RadiusX="42" RadiusY="19">
            <EllipseGeometry.Transform>
                <RotateTransform Angle="24" CenterX="168" CenterY="104" />
            </EllipseGeometry.Transform>
        </EllipseGeometry>
    </GeometryGroup>

    <EllipseGeometry x:Key="BeeMarkBodyGeometry" Center="128,153" RadiusX="40" RadiusY="51" />
    <EllipseGeometry x:Key="BeeMarkBodyClipGeometry" Center="128,153" RadiusX="40" RadiusY="51" />
    <EllipseGeometry x:Key="BeeMarkHeadGeometry" Center="128,94" RadiusX="34" RadiusY="34" />
    <RectangleGeometry x:Key="BeeMarkStripe1Geometry" Rect="82,137,92,17" />
    <RectangleGeometry x:Key="BeeMarkStripe2Geometry" Rect="82,171,92,17" />

    <Geometry x:Key="BeeMarkAntennaLeftGeometry">M 112,72 C 101,59 93,52 82,46</Geometry>
    <Geometry x:Key="BeeMarkAntennaRightGeometry">M 144,72 C 155,59 163,52 174,46</Geometry>

    <DrawingImage x:Key="BeeMarkImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BeeHexFillBrush}"
                                 Geometry="{StaticResource BeeHexGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource BeeRimBrush}" Thickness="5" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <GeometryDrawing Brush="{StaticResource BeeWingBrush}"
                                 Geometry="{StaticResource BeeMarkWingsGeometry}" />

                <GeometryDrawing Brush="{StaticResource BeeBodyBrush}"
                                 Geometry="{StaticResource BeeMarkBodyGeometry}" />
                <GeometryDrawing Brush="{StaticResource BeeBodyBrush}"
                                 Geometry="{StaticResource BeeMarkHeadGeometry}" />

                <GeometryDrawing Geometry="{StaticResource BeeMarkAntennaLeftGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource BeeBodyBrush}" Thickness="12"
                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="{StaticResource BeeMarkAntennaRightGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource BeeBodyBrush}" Thickness="12"
                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <GeometryDrawing Brush="{StaticResource BeeStripeBrush}">
                    <GeometryDrawing.Geometry>
                        <CombinedGeometry GeometryCombineMode="Intersect"
                                          Geometry1="{StaticResource BeeMarkStripe1Geometry}"
                                          Geometry2="{StaticResource BeeMarkBodyClipGeometry}" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource BeeStripeBrush}">
                    <GeometryDrawing.Geometry>
                        <CombinedGeometry GeometryCombineMode="Intersect"
                                          Geometry1="{StaticResource BeeMarkStripe2Geometry}"
                                          Geometry2="{StaticResource BeeMarkBodyClipGeometry}" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
