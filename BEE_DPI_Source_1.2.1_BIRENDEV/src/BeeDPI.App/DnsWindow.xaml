<Window x:Class="BeeDPI.App.DnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Quản lý DNS"
        Width="404"
        Height="556"
        MinWidth="340"
        MinHeight="380"
        MaxWidth="460"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Icon="assets/bee.ico"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="22"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            Margin="10"
            CornerRadius="22"
            Background="{StaticResource WindowBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              BlurRadius="22"
                              ShadowDepth="3"
                              Direction="270"
                              Opacity="0.55" />
        </Border.Effect>

        <Grid x:Name="FrameContent" ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Grid Grid.Row="0">
                    <Border Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,92,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">
                            <Image Source="{StaticResource BeeMarkImage}"
                                   Width="13"
                                   Height="13"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Quản lý DNS"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,9,0">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Thu nhỏ"
                                AutomationProperties.Name="Thu nhỏ cửa sổ DNS">
                            <Path Data="M 0,0 L 10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click"
                                Margin="3,0,0,0"
                                ToolTip="Đóng"
                                AutomationProperties.Name="Đóng cửa sổ DNS">
                            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,2,0"
                              Focusable="False">
                    <StackPanel Margin="22,4,20,20"
                                HorizontalAlignment="Stretch">

                        <TextBlock Text="DNS"
                                   Style="{StaticResource BrandTitleStyle}"
                                   HorizontalAlignment="Left"
                                   FontSize="21" />

                        <!-- Network being configured -->
                        <Border Style="{StaticResource StatusCardStyle}"
                                Margin="0,14,0,0"
                                Padding="14,11">
                            <StackPanel>
                                <TextBlock Text="MẠNG ĐANG SỬ DỤNG" Style="{StaticResource DnsLabelStyle}" />

                                <Grid Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ShowNetworkKindText, Converter={StaticResource BoolToVisibility}}">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="{StaticResource CyanBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding NetworkType}"
                                                   Style="{StaticResource DnsValueStyle}"
                                                   AutomationProperties.AutomationId="NetworkType"
                                                   AutomationProperties.Name="Mạng đang sử dụng" />
                                    </StackPanel>

                                    <ComboBox Style="{StaticResource DnsComboBoxStyle}"
                                              ItemsSource="{Binding Adapters}"
                                              SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              IsEnabled="{Binding IsIdle}"
                                              Visibility="{Binding ShowAdapterSelector, Converter={StaticResource BoolToVisibility}}"
                                              AutomationProperties.Name="Chọn mạng đang sử dụng" />
                                </Grid>

                                <TextBlock Text="Có nhiều kết nối cùng hoạt động. Hãy chọn đúng mạng."
                                           Style="{StaticResource DnsHintStyle}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding ShowAdapterSelector, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="Kết nối đang dùng có thể do VPN quản lý. Hãy kiểm tra lại mạng."
                                           Style="{StaticResource DnsHintStyle}"
                                           Foreground="{StaticResource DangerBrush}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding ShowNetworkWarning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- Provider -->
                        <TextBlock Text="NHÀ CUNG CẤP DNS"
                                   Style="{StaticResource DnsLabelStyle}"
                                   Margin="0,16,0,0" />
                        <ComboBox Style="{StaticResource DnsComboBoxStyle}"
                                  ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                  IsEnabled="{Binding IsIdle}"
                                  Margin="0,6,0,0"
                                  AutomationProperties.AutomationId="ProviderCombo"
                                  AutomationProperties.Name="Chọn nhà cung cấp DNS">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- DNS profile -->
                        <TextBlock Text="CHẾ ĐỘ DNS"
                                   Style="{StaticResource DnsLabelStyle}"
                                   Margin="0,13,0,0"
                                   Visibility="{Binding ShowProfileSelector, Converter={StaticResource BoolToVisibility}}" />
                        <ComboBox Style="{StaticResource DnsComboBoxStyle}"
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                  IsEnabled="{Binding IsIdle}"
                                  Margin="0,6,0,0"
                                  Visibility="{Binding ShowProfileSelector, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.AutomationId="ProfileCombo"
                                  AutomationProperties.Name="Chọn chế độ DNS">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProfileDisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Collapsed advanced options -->
                        <Button Style="{StaticResource AdvancedToggleStyle}"
                                Command="{Binding ToggleAdvancedCommand}"
                                Margin="0,12,0,0"
                                AutomationProperties.Name="Mở rộng tùy chọn nâng cao">
                            <Grid>
                                <TextBlock Text="Tùy chọn nâng cao"
                                           Style="{StaticResource DnsHintStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AdvancedChevron}"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <StackPanel Margin="0,2,0,0"
                                    Visibility="{Binding IsAdvancedOpen, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Visibility="{Binding ShowCustomFields, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="DNS IPv4"
                                           Style="{StaticResource DnsLabelStyle}"
                                           Margin="0,7,0,0" />
                                <TextBox Style="{StaticResource DnsTextBoxStyle}"
                                         Text="{Binding CustomIpv4, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsIdle}"
                                         Margin="0,5,0,0"
                                         AutomationProperties.Name="DNS IPv4 tùy chỉnh" />
                                <TextBlock Text="DNS IPv6"
                                           Style="{StaticResource DnsLabelStyle}"
                                           Margin="0,9,0,0" />
                                <TextBox Style="{StaticResource DnsTextBoxStyle}"
                                         Text="{Binding CustomIpv6, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsIdle}"
                                         Margin="0,5,0,0"
                                         AutomationProperties.Name="DNS IPv6 tùy chỉnh" />
                            </StackPanel>

                            <CheckBox Style="{StaticResource DnsCheckBoxStyle}"
                                      Content="Dùng DNS mã hóa (DoH)"
                                      IsChecked="{Binding UseDoh, Mode=TwoWay}"
                                      IsEnabled="{Binding CanUseDoh}"
                                      Margin="0,12,0,0"
                                      Visibility="{Binding ShowDohOption, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="Bật DNS over HTTPS gốc của Windows" />
                            <TextBlock Text="{Binding DohAvailability}"
                                       Style="{StaticResource DnsHintStyle}"
                                       Margin="0,5,0,0"
                                       Visibility="{Binding ShowDohOption, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- Actions -->
                        <Button Style="{StaticResource DnsPrimaryButtonStyle}"
                                Content="ÁP DỤNG DNS"
                                Command="{Binding ApplyCommand}"
                                IsEnabled="{Binding CanApply}"
                                Margin="0,18,0,0"
                                AutomationProperties.AutomationId="ApplyDnsButton"
                                AutomationProperties.Name="Áp dụng DNS" />

                        <Button Style="{StaticResource DnsActionButtonStyle}"
                                Content="KHÔI PHỤC DNS BAN ĐẦU"
                                Command="{Binding RestoreCommand}"
                                IsEnabled="{Binding CanRestore}"
                                Margin="0,8,0,0"
                                AutomationProperties.AutomationId="RestoreDnsButton"
                                AutomationProperties.Name="Khôi phục DNS ban đầu" />

                        <!-- Result notification -->
                        <Border Margin="0,12,0,0"
                                CornerRadius="11"
                                BorderThickness="1"
                                Padding="12,9"
                                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#14201A" />
                                    <Setter Property="BorderBrush" Value="#2C4A38" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Background" Value="#211317" />
                                            <Setter Property="BorderBrush" Value="#4A2830" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding StatusTitle}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           AutomationProperties.AutomationId="DnsStatusTitle"
                                           AutomationProperties.Name="Kết quả DNS">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding StatusMessage}"
                                           Margin="0,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DnsHintStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Recovery confirmation for external DNS changes -->
                        <Border Background="#211317"
                                BorderBrush="#4A2830"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="12,10"
                                Margin="0,10,0,0"
                                Visibility="{Binding IsConflictPending, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="DNS đã thay đổi bên ngoài BEE DPI."
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DangerBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Bản sao lưu gốc vẫn an toàn."
                                           Style="{StaticResource DnsHintStyle}"
                                           Margin="0,3,0,0" />
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource DnsActionButtonStyle}"
                                            Content="GHI ĐÈ &amp; KHÔI PHỤC"
                                            Command="{Binding OverwriteRestoreCommand}"
                                            AutomationProperties.Name="Ghi đè và khôi phục DNS" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource DnsActionButtonStyle}"
                                            Content="HỦY"
                                            Padding="14,0"
                                            Command="{Binding CancelConflictCommand}"
                                            AutomationProperties.Name="Hủy khôi phục DNS" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
