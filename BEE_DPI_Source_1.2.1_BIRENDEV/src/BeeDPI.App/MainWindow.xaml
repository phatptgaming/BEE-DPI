<Window x:Class="BeeDPI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BEE DPI"
        Width="424"
        Height="560"
        MinWidth="380"
        MinHeight="430"
        MaxWidth="470"
        MaxHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Icon="assets/bee.ico"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing"
        Closed="Window_Closed">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="22"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            Margin="10"
            CornerRadius="22"
            Background="{StaticResource WindowBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              BlurRadius="22"
                              ShadowDepth="3"
                              Direction="270"
                              Opacity="0.55" />
        </Border.Effect>

        <Grid x:Name="FrameContent" ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Grid Grid.Row="0">
                    <Border Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,92,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">
                        <Image Source="{StaticResource BeeMarkImage}"
                               Width="13"
                               Height="13"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" />
                            <TextBlock Text="BEE DPI"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VersionLabel}"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="7,1,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,9,0">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Thu nhỏ"
                                AutomationProperties.Name="Thu nhỏ cửa sổ">
                            <Path Data="M 0,0 L 10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click"
                                Margin="3,0,0,0"
                                ToolTip="Đóng cửa sổ"
                                AutomationProperties.Name="Đóng cửa sổ">
                            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Product, status and the two primary actions -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,2,0,0">

                    <Grid Width="78"
                          Height="78"
                          HorizontalAlignment="Center">
                        <Image Source="{StaticResource BeeMarkImage}"
                               Width="66"
                               Height="66"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>

                    <TextBlock Text="{Binding ProductName}"
                               Style="{StaticResource BrandTitleStyle}"
                               Margin="0,4,0,0" />

                    <TextBlock Text="{Binding DeveloperCredit}"
                               Style="{StaticResource CreditStyle}"
                               Margin="0,2,0,0" />

                    <Border x:Name="StatusPanel"
                            Width="312"
                            Style="{StaticResource StatusCardStyle}"
                            Margin="0,14,0,0"
                            AutomationProperties.AutomationId="StatusCard">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="1,0,10,0">
                                <Ellipse Width="11" Height="11" Opacity="0.22">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Connecting">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Disconnecting">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Connected">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Error">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <Ellipse Width="7" Height="7">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#6E7480" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Connecting">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Disconnecting">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Connected">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Error">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}"
                                           Style="{StaticResource StatusTextStyle}"
                                           AutomationProperties.AutomationId="StatusText"
                                           AutomationProperties.Name="Trạng thái kết nối"
                                           AutomationProperties.HelpText="{Binding StatusText}" />
                                <TextBlock Text="{Binding StatusHint}"
                                           Style="{StaticResource StatusHintStyle}"
                                           Visibility="{Binding ShowStatusHint, Converter={StaticResource BoolToVisibility}}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ToggleCommand}"
                            Width="312"
                            Margin="0,12,0,0"
                            AutomationProperties.AutomationId="ConnectButton"
                            AutomationProperties.Name="Kết nối hoặc hủy kết nối">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7E8;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0" />
                            <TextBlock Text="{Binding ButtonText}"
                                       FontFamily="{StaticResource UiFontFamily}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Width="312"
                            Height="36"
                            Margin="0,7,0,0"
                            Click="DnsButton_Click"
                            ToolTip="Mở cửa sổ quản lý DNS"
                            AutomationProperties.AutomationId="DnsButton"
                            AutomationProperties.Name="Quản lý DNS">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE774;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="QUẢN LÝ DNS"
                                       FontFamily="{StaticResource UiFontFamily}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Subtle social links -->
                <Grid Grid.Row="2" Margin="22,0,22,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource SocialButtonStyle}"
                                Click="FacebookButton_Click"
                                ToolTip="Facebook"
                                AutomationProperties.Name="Facebook">
                            <Path Data="M 13.6,3.2 L 11.5,3.2 C 9.7,3.2 8.6,4.4 8.6,6.4 L 8.6,8.4 L 6.4,8.4 L 6.4,11 L 8.6,11 L 8.6,20 L 11.5,20 L 11.5,11 L 13.9,11 L 14.2,8.4 L 11.5,8.4 L 11.5,6.7 C 11.5,6 11.8,5.6 12.6,5.6 L 14.2,5.6 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource SocialButtonStyle}"
                                Click="TikTokButton_Click"
                                Margin="4,0,0,0"
                                ToolTip="TikTok"
                                AutomationProperties.Name="TikTok">
                            <Path Data="M 16.6,3 C 17,5.2 18.4,6.7 20.6,6.9 L 20.6,9.6 C 19.3,9.7 18.1,9.3 17,8.5 L 17,14.4 C 17,17.6 14.7,20 11.5,20 C 8.4,20 6,17.7 6,14.8 C 6,11.7 8.4,9.4 11.6,9.7 L 11.6,12.5 C 10.1,12.2 8.9,13 8.9,14.5 C 8.9,15.8 9.8,16.7 11,16.7 C 12.4,16.7 13.2,15.7 13.2,14.1 L 13.2,3 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform" />
                        </Button>

                        <Border Width="1"
                                Height="12"
                                Background="{StaticResource BorderBrush}"
                                Margin="10,0"
                                VerticalAlignment="Center" />

                        <Button Style="{StaticResource LinkButtonStyle}"
                                Click="DiscordButton_Click"
                                ToolTip="Discord"
                                AutomationProperties.Name="Discord">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8.2,6.4 C 6.6,7.2 5.3,8.3 4.4,9.8 C 3.2,12.2 3,15.3 3.6,17.4 C 5.1,18.5 6.6,19.1 8,19.4 L 8.9,17.8 C 8,17.5 7.2,17.1 6.5,16.6 L 7.1,16.2 C 9.6,17.4 12.4,17.4 14.9,16.2 L 15.5,16.6 C 14.8,17.1 14,17.5 13.1,17.8 L 14,19.4 C 15.4,19.1 16.9,18.5 18.4,17.4 C 19,15.3 18.8,12.2 17.6,9.8 C 16.7,8.3 15.4,7.2 13.8,6.4 L 13.4,7.2 C 12.3,7 11.7,7 10.6,7.2 Z M 9.2,14.4 C 8.5,14.4 8,13.8 8,13.1 C 8,12.4 8.5,11.8 9.2,11.8 C 9.9,11.8 10.4,12.4 10.4,13.1 C 10.4,13.8 9.9,14.4 9.2,14.4 Z M 14.8,14.4 C 14.1,14.4 13.6,13.8 13.6,13.1 C 13.6,12.4 14.1,11.8 14.8,11.8 C 15.5,11.8 16,12.4 16,13.1 C 16,13.8 15.5,14.4 14.8,14.4 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="discord.com/vthienbhat"
                                           FontSize="9.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
